# ====================================================================
# 《云山竹简 · 华风雅集》仓库根级 Git 忽略配置
# ====================================================================

# 依赖目录
node_modules/
frontend/node_modules/
backend/node_modules/

# 构建产物
dist/
dist-ssr/
frontend/dist/
build/

# 环境变量与敏感凭证（严禁提交任何带有真实密钥的文件）
.env
.env.local
.env.*.local
frontend/.env.local
backend/.env
backend/.env.local

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 系统与编辑器缓存
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 临时与测试产物
tmp/
temp/
.temp/
coverage/
.nyc_output/
backend/uploads_temp/
backend/public/uploads/avatars/*
!backend/public/uploads/avatars/.gitkeep

# AI 出图工具的默认导出文件（易误落仓库根目录，非项目素材）
ChatGPT 图像*
ChatGPT Image*
DALL·E*
Midjourney_*

# 交付文档生成时的临时裁剪副本（每次生成都会重建，不入库）
proof/_fit_*.png
