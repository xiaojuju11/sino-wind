# 服务端口
PORT=3000

# 必填：独立随机 JWT 签名密钥（至少32字符；勿使用公开示例值）
# 在 backend 目录运行 node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))" 生成后填入 .env.local
JWT_SECRET=

# 本地 MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=parent_kid_education

# AI 对话（DeepSeek API Key）
# 获取地址：https://platform.deepseek.com/
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key

# AI 图像识别（Coze 工作流配置）
# 工作流 Webhook Endpoint（当前团队工作流「工作流 1」；旧地址 r85vf8qf77 已 404，勿再使用）
# 若队长重新发布工作流，只需替换本行，无需改代码
COZE_ENDPOINT=https://6xqyp2kf72.coze.site/run
# 工作流 API Token / 鉴权密钥（向工作流负责人索取，切勿提交到仓库）
# Token 的 aud 必须与所用工作流绑定，换工作流需同时换 Token，否则上游返回 401
COZE_API_TOKEN=your_coze_workflow_token
# 兼容历史命名（后端优先读 COZE_API_TOKEN，本项仅作兜底）
VITE_COZE_IMAGE_TO_TEXT_AND_VOICE=your_coze_workflow_token
# 工作流超时时间（毫秒，默认 60000ms = 60s；前端等待 65s）
COZE_TIMEOUT=60000
