# 服务端口
PORT=3000

# 必填：独立随机 JWT 签名密钥（至少32字符；勿使用公开示例值）
# 在 backend 目录运行 node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))" 生成后填入 .env.local
JWT_SECRET=

# 本地 MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=parent_kid_education

# AI 对话（DeepSeek API Key）
# 获取地址：https://platform.deepseek.com/
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key

# AI 图像识别（Coze 工作流配置）
# 工作流 Webhook Endpoint（默认官方或自建 Endpoint）
COZE_ENDPOINT=https://r85vf8qf77.coze.site/run
# 工作流 API Token / 鉴权密钥
COZE_API_TOKEN=your_coze_workflow_token
# 兼容历史命名
VITE_COZE_IMAGE_TO_TEXT_AND_VOICE=your_coze_workflow_token
# 工作流超时时间（毫秒，默认 60000ms = 60s；前端等待 65s）
COZE_TIMEOUT=60000
